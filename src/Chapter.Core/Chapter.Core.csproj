<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-specific: the editor launcher probes the registry to find Rider and
         VS Code, which cannot be assumed to live in their default folders. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />

    <!-- The official Claude SDK. Phase 2 keeps message generation in C# rather than adding a
         Node process for it: the backend is already here, and the whole design of this app is
         that there is one runtime, not two. -->
    <PackageReference Include="Anthropic" Version="12.40.0" />

    <!-- DPAPI, for the API key. Not in the framework since .NET Core, and the alternative is
         either plaintext or hand-rolled crypto. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parsers are internal but are the highest-value thing to test directly. -->
    <InternalsVisibleTo Include="Chapter.Core.Tests" />
  </ItemGroup>

</Project>
